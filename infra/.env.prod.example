SERVER_IMAGE=docker.io/your-dockerhub-id/atchagong-server:COMMIT_SHA

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=atchagong
MYSQL_USER=atchagong
MYSQL_PASSWORD=change-me-user-password

JWT_SECRET=change-me-long-random-secret

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

BACKUP_S3_BUCKET=atchagong-prod-backups
BACKUP_S3_PREFIX=mysql
BACKUP_RETENTION_DAYS=7
BACKUP_UPLOAD_RETRIES=3
AWS_CLI_CONNECT_TIMEOUT=10
AWS_CLI_READ_TIMEOUT=60
